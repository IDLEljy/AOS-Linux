diff -ruN linux-pristine/include/uapi/linux/aos.h linux-src/include/uapi/linux/aos.h
--- linux-pristine/include/uapi/linux/aos.h	1970-01-01 08:00:00.000000000 +0800
+++ linux-src/include/uapi/linux/aos.h	2026-10-25 11:39:56.702907574 +0800
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * AOS (Agent Operating System) - user space API.
+ *
+ * AOS is a minimal task-containment facility for agent workloads: a
+ * supervisor creates an AOS task, starts a transient scope, then binds
+ * the task to that scope using an open cgroup v2 directory descriptor.
+ * Every task in the bound cgroup subtree is subject to the policy.
+ */
+#ifndef _UAPI_LINUX_AOS_H
+#define _UAPI_LINUX_AOS_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define AOS_ABI_VERSION	1
+#define AOS_TASK_ID_LEN	64
+#define AOS_PATH_MAX	1024
+
+/*
+ * Restriction bits, set at task creation time and enforced by the LSM
+ * hooks.  Everything not requested stays permissive.
+ */
+#define AOS_RESTRICT_EXEC	(1ULL << 0)	/* exec only via pinned path */
+#define AOS_RESTRICT_READ	(1ULL << 1)	/* file reads inside wokspace only */
+#define AOS_RESTRICT_WRITE	(1ULL << 2)	/* file writes inside wokspace only */
+#define AOS_RESTRICT_ALL	(AOS_RESTRICT_EXEC | \
+				 AOS_RESTRICT_READ | \
+				 AOS_RESTRICT_WRITE)
+
+/*
+ * Audit verbosity.  Level 0 disables AOS audit records; level 1 records
+ * denials; level 2 records every checked operation.
+ */
+#define AOS_AUDIT_NONE		0
+#define AOS_AUDIT_DENY		1
+#define AOS_AUDIT_ALL		2
+
+/**
+ * struct aos_task_create - argument for AOS_IOC_TASK_CREATE
+ * @label:		nul-terminated human readable name (<= AOS_TASK_ID_LEN)
+ * @workspace_path:	nul-terminated workspace directory path
+ * @exec_path:		nul-terminated pinned executable path (may be empty)
+ * @restrict_flags:	bitmask of AOS_RESTRICT_*
+ * @audit_level:	one of AOS_AUDIT_*
+ * @task_id:		output: the kernel-assigned task id
+ */
+struct aos_task_create {
+	char	label[AOS_TASK_ID_LEN];
+	char	workspace_path[AOS_PATH_MAX];
+	char	exec_path[AOS_PATH_MAX];
+	__u64	restrict_flags;
+	__u64	audit_level;
+	__u64	task_id;
+};
+
+/**
+ * struct aos_task_bind - argument for AOS_IOC_TASK_BIND
+ * @task_id:	id returned by AOS_IOC_TASK_CREATE
+ * @cgroup_fd:	fd of an open non-root cgroup v2 directory; scope must be stopped before finish
+ * @flags:	must be 0
+ */
+struct aos_task_bind {
+	__u64	task_id;
+	__s32	cgroup_fd;
+	__u32	flags;
+};
+
+/**
+ * struct aos_task_query - argument for AOS_IOC_TASK_QUERY
+ * @task_id:	id to query
+ * @flags:	must be 0
+ * @n_threads:	output: live thread-group leaders in the bound cgroup subtree
+ * @n_finished:	output: number of threads that already finished
+ * @restrict_flags: output: the task's restriction mask
+ * @audit_level:	output: the task's audit level
+ */
+struct aos_task_query {
+	__u64	task_id;
+	__u64	flags;
+	__u64	n_threads;
+	__u64	n_finished;
+	__u64	restrict_flags;
+	__u64	audit_level;
+};
+
+/**
+ * struct aos_task_finish - argument for AOS_IOC_TASK_FINISH
+ * @task_id:	id of the task being retired
+ * @flags:	must be 0
+ */
+struct aos_task_finish {
+	__u64	task_id;
+	__u64	flags;
+};
+
+/**
+ * struct aos_task_policy - argument for AOS_IOC_TASK_POLICY
+ * @task_id:	id of the task to modify
+ * @flags:	must be 0
+ * @restrict_flags: new restriction mask (AOS_RESTRICT_*)
+ * @audit_level:	new audit level (AOS_AUDIT_*)
+ */
+struct aos_task_policy {
+	__u64	task_id;
+	__u64	flags;
+	__u64	restrict_flags;
+	__u64	audit_level;
+};
+
+#define AOS_IOC_MAGIC		0xA9
+#define AOS_IOC_GET_ABI_VERSION _IOR(AOS_IOC_MAGIC, 0x00, __u32)
+
+#define AOS_IOC_TASK_CREATE	_IOWR(AOS_IOC_MAGIC, 0x01, struct aos_task_create)
+#define AOS_IOC_TASK_BIND	_IOW(AOS_IOC_MAGIC, 0x02, struct aos_task_bind)
+#define AOS_IOC_TASK_POLICY	_IOW(AOS_IOC_MAGIC, 0x03, struct aos_task_policy)
+#define AOS_IOC_TASK_QUERY	_IOWR(AOS_IOC_MAGIC, 0x04, struct aos_task_query)
+#define AOS_IOC_TASK_FINISH	_IOW(AOS_IOC_MAGIC, 0x05, struct aos_task_finish)
+
+#endif /* _UAPI_LINUX_AOS_H */
