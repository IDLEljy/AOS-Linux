+#endif
diff -ruN linux-pristine/security/aos/aos_lsm.c linux-src/security/aos/aos_lsm.c
--- linux-pristine/security/aos/aos_lsm.c	1970-01-01 08:00:00.000000000 +0800
+++ linux-src/security/aos/aos_lsm.c	2026-10-25 11:39:28.632581237 +0800
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "aos_internal.h"
+bool aos_enabled __ro_after_init;
+static int aos_bprm_check_security(struct linux_binprm *bprm)
+{
+ struct aos_task *task=aos_task_for_current(); int ret=0;
+ if(!task) return 0;
+ if(!aos_policy_exec_allowed(task,&bprm->file->f_path)) ret=-EACCES;
+ if(ret) aos_audit_event(task,"exec",bprm->filename,false,ret);
+ aos_task_put(task); return ret;
+}
+static int aos_check_file(struct file *file,int mask,bool mmap)
+{
+ struct aos_task *task=aos_task_for_current(); int ret=0;
+ if(!task) return 0;
+ if((mask&MAY_WRITE)&&!aos_policy_file_write_allowed(task,&file->f_path)) ret=-EACCES;
+ else if((mask&MAY_READ)&&!aos_policy_file_read_allowed(task,&file->f_path)) ret=-EACCES;
+ if(ret) aos_audit_event(task,mmap?"mmap":"file-access",NULL,false,ret);
+ aos_task_put(task); return ret;
+}
+static int aos_file_open(struct file *file)
+{
+ int mask=0;
+ if(file->f_mode&FMODE_READ) mask|=MAY_READ;
+ if(file->f_mode&FMODE_WRITE) mask|=MAY_WRITE;
+ return aos_check_file(file,mask,false);
+}
+static int aos_file_permission(struct file *file,int mask)
+{ return aos_check_file(file,mask,false); }
+static int aos_mmap_file(struct file *file,unsigned long reqprot,unsigned long prot,unsigned long flags)
+{
+ int mask=(prot&PROT_WRITE)?MAY_WRITE:MAY_READ;
+ return aos_check_file(file,mask,true);
+}
+static int aos_check_dir(const struct path *dir,const char *op)
+{
+ struct aos_task *task=aos_task_for_current(); int ret=0;
+ if(!task) return 0;
+ if(!aos_policy_file_write_allowed(task,dir)) ret=-EACCES;
+ if(ret) aos_audit_event(task,op,NULL,false,ret);
+ aos_task_put(task); return ret;
+}
+static int aos_path_truncate(const struct path *path) { return aos_check_dir(path,"truncate"); }
+static int aos_path_mkdir(const struct path *dir,struct dentry *dentry,umode_t mode) { return aos_check_dir(dir,"mkdir"); }
+static int aos_path_rmdir(const struct path *dir,struct dentry *dentry) { return aos_check_dir(dir,"rmdir"); }
+static int aos_path_unlink(const struct path *dir,struct dentry *dentry) { return aos_check_dir(dir,"unlink"); }
+static int aos_path_mknod(const struct path *dir,struct dentry *dentry,umode_t mode,unsigned int dev) { return aos_check_dir(dir,"mknod"); }
+static int aos_path_symlink(const struct path *dir,struct dentry *dentry,const char *old_name) { return aos_check_dir(dir,"symlink"); }
+static int aos_path_link(struct dentry *old,const struct path *new_dir,struct dentry *new_dentry) { return aos_check_dir(new_dir,"link"); }
+static int aos_path_rename(const struct path *old_dir,struct dentry *old_dentry,const struct path *new_dir,struct dentry *new_dentry,unsigned int flags)
+{
+ int ret=aos_check_dir(old_dir,"rename"); return ret?ret:aos_check_dir(new_dir,"rename");
+}
+static struct security_hook_list aos_hooks[] __ro_after_init={
+ LSM_HOOK_INIT(bprm_check_security,aos_bprm_check_security),
+ LSM_HOOK_INIT(file_open,aos_file_open), LSM_HOOK_INIT(file_permission,aos_file_permission),
+ LSM_HOOK_INIT(mmap_file,aos_mmap_file), LSM_HOOK_INIT(path_mkdir,aos_path_mkdir),
+ LSM_HOOK_INIT(path_rmdir,aos_path_rmdir), LSM_HOOK_INIT(path_unlink,aos_path_unlink),
+ LSM_HOOK_INIT(path_mknod,aos_path_mknod), LSM_HOOK_INIT(path_symlink,aos_path_symlink),
+ LSM_HOOK_INIT(path_link,aos_path_link), LSM_HOOK_INIT(path_rename,aos_path_rename),
+ LSM_HOOK_INIT(path_truncate,aos_path_truncate),
+};
+const struct lsm_id aos_lsmid={.name="aos",.id=LSM_ID_AOS};
+int __init aos_lsm_init(void)
+{
+ security_add_hooks(aos_hooks,ARRAY_SIZE(aos_hooks),&aos_lsmid);
+ aos_enabled=true; return aos_control_init();
+}
+DEFINE_LSM(aos)={.name="aos",.init=aos_lsm_init};
diff -ruN linux-pristine/security/aos/aos_policy.c linux-src/security/aos/aos_policy.c
--- linux-pristine/security/aos/aos_policy.c	1970-01-01 08:00:00.000000000 +0800
+++ linux-src/security/aos/aos_policy.c	2026-10-25 11:22:32.027529246 +0800
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "aos_internal.h"
+
+int __init aos_policy_init(void)
+{
+	return 0;
+}
+
+int aos_policy_check_restrict_flags(u64 flags)
+{
+	return flags & ~AOS_RESTRICT_ALL ? -EINVAL : 0;
+}
+
+int aos_policy_check_audit_level(u64 level)
+{
+	return level > AOS_AUDIT_ALL ? -EINVAL : 0;
+}
+
+bool aos_policy_exec_allowed(struct aos_task *task, const struct path *path)
+{
+	return !(READ_ONCE(task->restrict_flags) & AOS_RESTRICT_EXEC) ||
+		path_equal(path, &task->executable);
+}
+
+bool aos_policy_file_read_allowed(struct aos_task *task, const struct path *path)
+{
+	return !(READ_ONCE(task->restrict_flags) & AOS_RESTRICT_READ) ||
+		path_is_under(path, &task->workspace);
+}
+
+bool aos_policy_file_write_allowed(struct aos_task *task, const struct path *path)
+{
+	return !(READ_ONCE(task->restrict_flags) & AOS_RESTRICT_WRITE) ||
+		path_is_under(path, &task->workspace);
+}
diff -ruN linux-pristine/security/aos/aos_task.c linux-src/security/aos/aos_task.c
--- linux-pristine/security/aos/aos_task.c	1970-01-01 08:00:00.000000000 +0800
+++ linux-src/security/aos/aos_task.c	2026-10-25 11:39:56.702907574 +0800
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "aos_internal.h"
+#define AOS_HASH_BITS 4
+static DEFINE_HASHTABLE(aos_task_hash, AOS_HASH_BITS);
+static DEFINE_MUTEX(aos_registry_lock);
+static atomic64_t aos_next_id = ATOMIC64_INIT(1);
+static void aos_task_free(struct kref *kref)
+{
+ struct aos_task *task = container_of(kref, struct aos_task, kref);
+ if (task->cgrp) cgroup_put(task->cgrp);
+ if (task->workspace.dentry) path_put(&task->workspace);
+ if (task->executable.dentry) path_put(&task->executable);
+ kfree(task);
+}
+void aos_task_put(struct aos_task *task) { if (task) kref_put(&task->kref, aos_task_free); }
+static struct aos_task *aos_task_alloc(void)
+{
+ struct aos_task *task = kzalloc(sizeof(*task), GFP_KERNEL_ACCOUNT);
+ if (!task) return NULL;
+ kref_init(&task->kref); spin_lock_init(&task->lock); atomic64_set(&task->n_finished, 0);
+ return task;
+}
+struct aos_task *aos_task_get(u64 id)
+{
+ struct aos_task *task;
+ mutex_lock(&aos_registry_lock);
+ hash_for_each_possible(aos_task_hash, task, hash, id) if (task->id == id) {
+  kref_get(&task->kref); mutex_unlock(&aos_registry_lock); return task;
+ }
+ mutex_unlock(&aos_registry_lock); return NULL;
+}
+int __init aos_task_init(void) { return 0; }
+struct aos_task *aos_task_create_task(const char *label, const char *workspace_path,
+ const char *exec_path, u64 restrict_flags, u64 audit_level, u64 *out_id)
+{
+ struct aos_task *task = aos_task_alloc(); long ret;
+ if (!task) return ERR_PTR(-ENOMEM);
+ ret=aos_copy_label(task->label,sizeof(task->label),label); if(ret<0) goto err;
+ ret=aos_copy_path(task->workspace_path,sizeof(task->workspace_path),workspace_path); if(ret<0) goto err;
+ ret=aos_copy_path(task->exec_path,sizeof(task->exec_path),exec_path); if(ret<0) goto err;
+ ret=aos_policy_check_restrict_flags(restrict_flags); if(ret<0) goto err;
+ ret=aos_policy_check_audit_level(audit_level); if(ret<0) goto err;
+ ret=kern_path(task->workspace_path,LOOKUP_FOLLOW|LOOKUP_DIRECTORY,&task->workspace); if(ret) goto err;
+ if(task->exec_path[0]) { ret=kern_path(task->exec_path,LOOKUP_FOLLOW,&task->executable); if(ret) goto err; }
+ if((restrict_flags&AOS_RESTRICT_EXEC)&&!task->executable.dentry) { ret=-EINVAL; goto err; }
+ task->restrict_flags=restrict_flags; task->audit_level=audit_level;
+ task->id=atomic64_fetch_add(1,&aos_next_id);
+ mutex_lock(&aos_registry_lock); hash_add(aos_task_hash,&task->hash,task->id); mutex_unlock(&aos_registry_lock);
+ aos_audit_event(task,"task-create",NULL,true,0); *out_id=task->id; return task;
+err: aos_task_put(task); return ERR_PTR(ret);
+}
+int aos_task_bind(struct aos_task *task,int cgroup_fd)
+{
+ struct cgroup *cgrp=cgroup_get_from_fd(cgroup_fd); int ret=0;
+ if(IS_ERR(cgrp)) return PTR_ERR(cgrp);
+ if(cgrp->root!=&cgrp_dfl_root || cgrp==&cgrp_dfl_root.cgrp) { cgroup_put(cgrp); return -EINVAL; }
+ mutex_lock(&aos_registry_lock);
+ if(hlist_unhashed(&task->hash)) ret=-ENOENT;
+ else if(task->cgrp) ret=-EALREADY;
+ else task->cgrp=cgrp;
+ mutex_unlock(&aos_registry_lock);
+ if(ret) cgroup_put(cgrp); else aos_audit_event(task,"task-bind",NULL,true,0);
+ return ret;
+}
+int aos_task_finish(u64 id)
+{
+ struct aos_task *task;
+ mutex_lock(&aos_registry_lock);
+ hash_for_each_possible(aos_task_hash,task,hash,id) if(task->id==id) {
+  if(task->cgrp && cgroup_is_populated(task->cgrp)) {
+   mutex_unlock(&aos_registry_lock);
+   return -EBUSY;
+  }
+  task->finishing=true;
+  hash_del_init(&task->hash); mutex_unlock(&aos_registry_lock);
+  aos_audit_event(task,"task-finish",NULL,true,0); aos_task_put(task); return 0;
+ }
+ mutex_unlock(&aos_registry_lock); return -ENOENT;
+}
+struct aos_task *aos_task_for_current(void)
+{
+ struct cgroup *cgrp=task_dfl_cgroup(current); struct aos_task *task,*found=NULL;
+ mutex_lock(&aos_registry_lock);
+ hash_for_each(aos_task_hash,task,hash) if(!task->finishing && task->cgrp&&cgroup_is_descendant(cgrp,task->cgrp)) {
+  kref_get(&task->kref); found=task; break;
+ }
+ mutex_unlock(&aos_registry_lock); return found;
+}
+u64 aos_task_count_cgroup(struct aos_task *task)
+{
+ struct css_task_iter it; struct task_struct *p; u64 count=0;
+ if(!task->cgrp) return 0;
+ css_task_iter_start(&task->cgrp->self,0,&it);
+ while((p=css_task_iter_next(&it))) if(cgroup_is_descendant(task_dfl_cgroup(p),task->cgrp)) count++;
+ css_task_iter_end(&it); return count;
+}
+long aos_copy_label(char *d,size_t n,const char *s) { return strscpy(d,s,n)<0?-EINVAL:0; }
+long aos_copy_path(char *d,size_t n,const char *s) { return strscpy(d,s,n)<0?-EINVAL:0; }
