+++ linux-src/security/aos/Kconfig	2026-10-25 11:45:36.417959205 +0800
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config SECURITY_AOS
+	bool "AOS agent task containment"
+	depends on SECURITY && CGROUPS
+	select SECURITY_PATH
+	
+	default n
+	help
+	  Enable the AOS experimental task containment LSM. A privileged
+	  supervisor creates domains through /dev/aosctl
+	  and binds the policy to a cgroup v2 directory. All tasks in that
+	  cgroup subtree are checked by the AOS LSM. Workspace and executable paths are pinned.
+	  Unbound tasks are unaffected. Include aos in CONFIG_LSM to enable.
+
+	  If unsure, say N.
