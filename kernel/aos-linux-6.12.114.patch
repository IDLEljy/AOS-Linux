diff -ruN linux-pristine/security/aos/aos_audit.c linux-src/security/aos/aos_audit.c
--- linux-pristine/security/aos/aos_audit.c	1970-01-01 08:00:00.000000000 +0800
+++ linux-src/security/aos/aos_audit.c	2026-10-25 11:37:36.373276977 +0800
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AOS audit: emit audit records for AOS task lifecycle and access
+ * decisions, honouring the task's audit_level.
+ */
+
+#include "aos_internal.h"
+
+static void aos_audit_print(struct aos_task *task, const char *op,
+			    const char *path, bool allowed, int eno_hint)
+{
+	struct audit_buffer *ab;
+
+	if (!task || !task->audit_level)
+		return;
+	if (!allowed && task->audit_level < AOS_AUDIT_DENY)
+		return;
+	if (allowed && task->audit_level < AOS_AUDIT_ALL)
+		return;
+
+	ab = audit_log_start(audit_context(), GFP_ATOMIC, AUDIT_ANOM_ABEND);
+	if (!ab)
+		return;
+
+	audit_log_format(ab, "aos op=%s task_id=%llu label=\"%s\" allowed=%d",
+			 op, task->id, task->label, allowed);
+	if (path && path[0])
+		audit_log_format(ab, " path=\"%s\"", path);
+	if (!allowed)
+		audit_log_format(ab, " eno=%d", eno_hint);
+	audit_log_end(ab);
+}
+
+void aos_audit_event(struct aos_task *task, const char *op, const char *path,
+		     bool allowed, int eno_hint)
+{
+	aos_audit_print(task, op, path, allowed, eno_hint);
+}
+
+int __init aos_audit_init(void)
+{
+	return 0;
+}
diff -ruN linux-pristine/security/aos/aos_control.c linux-src/security/aos/aos_control.c
--- linux-pristine/security/aos/aos_control.c	1970-01-01 08:00:00.000000000 +0800
+++ linux-src/security/aos/aos_control.c	2026-10-25 11:40:42.078051563 +0800
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "aos_internal.h"
+#include <linux/user_namespace.h>
+
+static const struct file_operations aos_control_fops={
+ .owner=THIS_MODULE,.unlocked_ioctl=aos_control_ioctl,.compat_ioctl=compat_ptr_ioctl,
+ .llseek=no_llseek,
+};
+static struct miscdevice aos_control_device={
+ .minor=MISC_DYNAMIC_MINOR,.name="aosctl",.fops=&aos_control_fops,.mode=0600,
+};
+long aos_control_ioctl(struct file *file,unsigned int cmd,unsigned long arg)
+{
+ void __user *uarg=(void __user *)arg; struct aos_task *task; long ret;
+ if(!ns_capable(&init_user_ns,CAP_SYS_ADMIN)) return -EPERM;
+ if(cmd==AOS_IOC_GET_ABI_VERSION) { __u32 version=AOS_ABI_VERSION; return copy_to_user(uarg,&version,sizeof(version))?-EFAULT:0; }
+ switch(cmd) {
+ case AOS_IOC_TASK_CREATE: {
+  struct aos_task_create karg; u64 id;
+  if(copy_from_user(&karg,uarg,sizeof(karg))) return -EFAULT;
+  if(!memchr(karg.label,0,sizeof(karg.label))||!memchr(karg.workspace_path,0,sizeof(karg.workspace_path))||!memchr(karg.exec_path,0,sizeof(karg.exec_path))) return -EINVAL;
+  task=aos_task_create_task(karg.label,karg.workspace_path,karg.exec_path,karg.restrict_flags,karg.audit_level,&id);
+  if(IS_ERR(task)) return PTR_ERR(task);
+  aos_task_put(task); karg.task_id=id;
+  return copy_to_user(uarg,&karg,sizeof(karg))?-EFAULT:0;
+ }
+ case AOS_IOC_TASK_BIND: {
+  struct aos_task_bind karg;
+  if(copy_from_user(&karg,uarg,sizeof(karg))) return -EFAULT;
+  if(karg.flags) return -EINVAL;
+  task=aos_task_get(karg.task_id); if(!task) return -ENOENT;
+  ret=aos_task_bind(task,karg.cgroup_fd); aos_task_put(task); return ret;
+ }
+ case AOS_IOC_TASK_POLICY: {
+  struct aos_task_policy karg;
+  if(copy_from_user(&karg,uarg,sizeof(karg))) return -EFAULT;
+  if(karg.flags) return -EINVAL;
+  task=aos_task_get(karg.task_id); if(!task) return -ENOENT;
+  ret=aos_policy_check_restrict_flags(karg.restrict_flags);
+  if(!ret&&(karg.restrict_flags&AOS_RESTRICT_EXEC)&&!task->executable.dentry) ret=-EINVAL;
+  if(!ret) ret=aos_policy_check_audit_level(karg.audit_level);
+  if(!ret) { spin_lock(&task->lock); WRITE_ONCE(task->restrict_flags,karg.restrict_flags); WRITE_ONCE(task->audit_level,karg.audit_level); spin_unlock(&task->lock); aos_audit_event(task,"task-policy",NULL,true,0); }
+  aos_task_put(task); return ret;
+ }
+ case AOS_IOC_TASK_QUERY: {
+  struct aos_task_query karg;
+  if(copy_from_user(&karg,uarg,sizeof(karg))) return -EFAULT;
+  if(karg.flags) return -EINVAL;
+  task=aos_task_get(karg.task_id); if(!task) return -ENOENT;
+  karg.n_threads=aos_task_count_cgroup(task); karg.n_finished=atomic64_read(&task->n_finished);
+  karg.restrict_flags=READ_ONCE(task->restrict_flags); karg.audit_level=READ_ONCE(task->audit_level);
+  aos_task_put(task); return copy_to_user(uarg,&karg,sizeof(karg))?-EFAULT:0;
+ }
+ case AOS_IOC_TASK_FINISH: {
+  struct aos_task_finish karg;
+  if(copy_from_user(&karg,uarg,sizeof(karg))) return -EFAULT;
+  if(karg.flags) return -EINVAL;
+  return aos_task_finish(karg.task_id);
+ }
+ default: return -ENOTTY;
+ }
+}
+int __init aos_control_init(void)
+{
+ int ret;
+ ret=aos_task_init(); if(ret) return ret;
+ ret=aos_policy_init(); if(ret) return ret;
+ ret=aos_audit_init(); if(ret) return ret;
+ return misc_register(&aos_control_device);
+}
diff -ruN linux-pristine/security/aos/aos_internal.h linux-src/security/aos/aos_internal.h
--- linux-pristine/security/aos/aos_internal.h	1970-01-01 08:00:00.000000000 +0800
