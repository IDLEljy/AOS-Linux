+bool aos_policy_file_read_allowed(struct aos_task *, const struct path *);
+bool aos_policy_file_write_allowed(struct aos_task *, const struct path *);
+int aos_policy_check_restrict_flags(u64);
+int aos_policy_check_audit_level(u64);
+extern const struct lsm_id aos_lsmid;
+int __init aos_lsm_init(void);
